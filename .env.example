# Shopier ödeme entegrasyonu
SHOPIER_API_KEY=
SHOPIER_SECRET_KEY=
SHOPIER_PAYMENT_URL=https://www.shopier.com/ShowProduct/api_pay4.php

# Admin panelinden girilen ödeme ve kargo API anahtarlarını şifrelemek için en az 32 karakter
PAYMENT_CONFIG_ENCRYPTION_KEY=

# Müşteri oturumlarını imzalamak için en az 32 karakterlik rastgele değer
NEXT_AUTH_SECRET=

# Virgülle ayrılmış yönetici e-posta adresleri
ADMIN_EMAILS=

# Şifre sıfırlama e-postaları (Resend)
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM="Terragolds <hesap@email.terragolds.com>"
PASSWORD_RESET_FROM_EMAIL="Terragolds <hesap@terragolds.com>"
# Sadece localhost testinde bağlantıyı ekranda göstermek için true yapın.
PASSWORD_RESET_DEV_MODE=false
EMAIL_VERIFICATION_DEV_MODE=false

# Google Search Console HTML etiketi doğrulama kodu
GOOGLE_SITE_VERIFICATION=
