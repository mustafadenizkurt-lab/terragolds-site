{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "terragolds-storefront",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    // Offset 17 minutes past the hour, not on it: the XML supplier sync
    // fails ~88% of the time when it runs exactly on the hour (00:00/06:00/
    // 12:00/18:00 UTC) but only ~24% of the time at odd minutes - almost
    // certainly many stores hitting the same feed's default cron schedule
    // at once. See xml_sync_logs history for the before/after comparison.
    "crons": ["17 */6 * * *"]
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "terragolds.com/api/*", "zone_name": "terragolds.com" },
    { "pattern": "www.terragolds.com/api/*", "zone_name": "terragolds.com" },
    { "pattern": "terragolds.com/*", "zone_name": "terragolds.com" },
    { "pattern": "www.terragolds.com/*", "zone_name": "terragolds.com" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "terragolds-db",
      "database_id": "749cfd48-7c4c-4ad7-ab5e-979c45ad1ae9",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "terragolds-media"
    }
  ]
}
